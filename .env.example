# Platform token (set the address once it's launched; token actions stay disabled until then)
VITE_TOKEN_SYMBOL=AGENT
VITE_TOKEN_ADDRESS=
# Baum Telegram bot and this platform's Baum referral code (a real Stable referral code)
VITE_BAUM_BOT=BaumReviewBot
VITE_BAUM_REF=AGENTARENA
# Server-side only, never VITE_*: set BAUM_API_KEY as a GitHub Actions secret.
# The Pages workflow uses it to fetch the leaderboard into data/*.json every 10 minutes.
# Locally: BAUM_API_KEY=... node scripts/fetch-leaderboard.mjs public  (then npm run dev)
