# Platform token (set the address once it's launched; token actions stay disabled until then)
VITE_TOKEN_SYMBOL=AGENT
VITE_TOKEN_ADDRESS=
# Baum Telegram bot and this platform's Baum referral code (a real Stable referral code)
VITE_BAUM_BOT=BaumReviewBot
VITE_BAUM_REF=AGENTARENA
# Baum origin serving GET /api/leaderboard (e.g. https://baumai.xyz). Empty = sample data.
VITE_BAUM_API=
