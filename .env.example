# Platform token (set the address once it's launched; token actions stay disabled until then)
VITE_TOKEN_SYMBOL=AGENT
VITE_TOKEN_ADDRESS=
# Baum Telegram bot and this platform's Baum referral code (a real Stable referral code)
VITE_BAUM_BOT=BaumReviewBot
VITE_BAUM_REF=AGENTARENA
# 1 = read the live leaderboard through this app's /api/leaderboard proxy. Empty = sample data.
VITE_LIVE_DATA=
# Server-only (Vercel env, never VITE_*): Baum origin and this platform's Baum partner API key.
# Get the key in the Baum bot with /apikey new. Calls are paid in BAUM credits; see README.
BAUM_API=https://baumai.xyz
BAUM_API_KEY=
